# ============================================================================
# NetGuardia Environment Configuration (.env.example)
# ============================================================================

# 1. Database Engine Configuration
# Local SQLite default:
DATABASE_URL="file:./netguardia.db"

# Production Neon PostgreSQL (Multi-site SaaS / Cloud DB mode):
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Master Vault Encryption Key Secret
NETGUARDIA_VAULT_SECRET="change-this-to-a-32-byte-production-master-secret"
