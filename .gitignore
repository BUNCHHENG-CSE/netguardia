# ============================================================================
# Git Ignore Configuration - NetGuardia & Full-Stack Monorepo
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ----------------------------------------------------------------------------
# Unanchored to ignore both root and nested packages (e.g. frontend/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------------------------------------------------------------------
# 2. Build Outputs & Bundler Caches
# ----------------------------------------------------------------------------
.next/
out/
build/
dist/
.cache/
.vite/
.turbo/

# ----------------------------------------------------------------------------
# 3. Python Artifacts & Virtual Environments (Backend)
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
.venv/
venv/
ENV/
env/
venv.bak/

# ----------------------------------------------------------------------------
# 4. Databases & SQLite Local State
# ----------------------------------------------------------------------------
# Excludes local databases, journals, write-ahead logs, and shared memory files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ----------------------------------------------------------------------------
# 5. Security Credentials & Cryptographic Keys (CRITICAL)
# ----------------------------------------------------------------------------
# NetGuardia Credential Vault master key (Fernet encryption at rest)
.vault_master.key
*.vault_master.key
*.key
*.pem
*.crt
*.cert

# ----------------------------------------------------------------------------
# 6. Environment Files & Secrets
# ----------------------------------------------------------------------------
# Ignore actual environment files containing secrets
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging

# Explicitly track template/example env files so other developers & CI have configurations
!.env.example
!.env*.example

# ----------------------------------------------------------------------------
# 7. TypeScript & Linters
# ----------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache

# ----------------------------------------------------------------------------
# 8. Logs & Diagnostic Output
# ----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----------------------------------------------------------------------------
# 9. IDE, Editor & OS Metadata
# ----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# IDEs
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ----------------------------------------------------------------------------
# 10. Deployment & Hosting Platforms
# ----------------------------------------------------------------------------
.vercel
