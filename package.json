{
  "name": "tct-netguardia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run db:prepare && next dev",
    "build": "bun run db:prepare && next build",
    "start": "next start",
    "lint": "eslint",
    "db:prepare": "bun run scripts/db-prep.js",
    "db:sqlite": "bun run scripts/db-prep.js sqlite",
    "db:neon": "bun run scripts/db-prep.js neon",
    "db:postgres": "bun run scripts/db-prep.js postgres",
    "db:push": "bun x prisma db push",
    "db:seed": "bun run scripts/seed.ts",
    "db:reset": "bun -e \"import { prisma } from './src/lib/prisma'; import { resetDatabase } from './src/lib/seedData'; await resetDatabase(prisma); console.log('Database reset complete.'); await prisma.$disconnect();\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0"
}
